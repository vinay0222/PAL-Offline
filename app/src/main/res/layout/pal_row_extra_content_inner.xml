<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:shimmer="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reletiveTop"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_gravity="center"
    android:layout_margin="10dp"
    app:ignore="NamespaceTypo">


    <ImageView
        android:id="@+id/imageViewThumnail"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/pal_books" />

    <ProgressBar
        android:id="@+id/progressBar5"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <com.idreameducation.ipreppal.util.TextViewBodyFont
        android:id="@+id/textViewVideoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/shimmer_view_container"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"

        android:layout_marginRight="10dp"
        android:layout_toRightOf="@+id/imageViewThumnail"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingLeft="5dp"
        android:text=""
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.idreameducation.ipreppal.util.RoundedHorizontalProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="100dp"
        android:layout_height="5dp"
        android:layout_below="@+id/textViewVideoName"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@+id/imageViewThumnail"
        android:indeterminate="false"
        android:progress="0"
        app:backgroundColor="#d3d3d3"
        app:progressColor="#a9a9a9" />

    <TextView
        android:id="@+id/textViewSelected"
        android:layout_width="3dp"
        android:visibility="gone"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:background="#FB9E36" />
</RelativeLayout>