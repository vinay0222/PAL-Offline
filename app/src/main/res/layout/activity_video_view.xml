<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/reletive"
    android:background="@drawable/transparent_rounded"
    android:orientation="horizontal"
    tools:ignore="MissingDefaultResource"
    tools:context=".pal.activity.VideoView_Activity">

    <RelativeLayout
        android:id="@+id/yt_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:orientation="horizontal">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtube_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

        <ImageView
            android:id="@+id/imageViewCrossVideo2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="10dp"
            android:scaleType="fitXY"
            app:srcCompat="@mipmap/cross" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/reletiveVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                />


        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="visible"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/slow_internet_Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@id/progressBar"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="Slow Internet Connection"
            android:textColor="@color/white"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageViewCrossVideo2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:visibility="gone"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="10dp"
            android:scaleType="fitXY"
            app:srcCompat="@mipmap/cross" />


        <ImageView
            android:id="@+id/imageViewCross"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_above="@+id/videoView"
            android:layout_alignParentRight="true"
            android:layout_marginTop="0dp"
            android:visibility="gone"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="-45dp"
            app:srcCompat="@mipmap/cross" />


        <ImageView
            android:id="@+id/imageViewFullScreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:layout_above="@+id/videoView"
            android:layout_alignParentRight="true"
            android:layout_marginTop="0dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="-40dp"
            app:srcCompat="@mipmap/full_screen" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/linearLayoutBottom"
            android:layout_margin="10dp"
            android:gravity="center"
            android:background="@drawable/video_background"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewCrossVideo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentLeft="true"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/ic_cross_white"
                android:padding="10dp"
                android:scaleType="fitXY" />

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/videoNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/imageViewCrossVideo"
                android:layout_marginTop="20dp"
                android:text=""
                android:textAllCaps="false"
                android:textSize="17sp"
                android:visibility="gone"
                android:textColor="@android:color/white" />

        </RelativeLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#80000000"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/next_sec_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginLeft="10dp"
                android:text="next video in 4s..  or "/>

            <TextView
                android:id="@+id/start_practice_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:text="Start Practice"
                android:visibility="gone"
                android:textColor="@color/white" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:visibility="gone"
            android:layout_marginBottom="80dp"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:id="@+id/textViewNextVideo"
                android:layout_marginRight="10dp"
                android:background="@drawable/transparent_button"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="Next Video"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/white" />

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:layout_width="120dp"
                android:id="@+id/textViewPractice"
                android:layout_height="50dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/transparent_button"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="Practice"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/white" />

        </LinearLayout>


    </RelativeLayout>


</RelativeLayout>