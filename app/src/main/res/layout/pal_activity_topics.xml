<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root_view">

        <ImageView
            android:id="@+id/imageViewDrawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:background="?selectableItemBackground"
            android:padding="6dp"
            android:src="@drawable/ic_hamburger" />

        <RelativeLayout
            android:id="@+id/classLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:visibility="visible"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@+id/imageViewDrawer"
            android:background="?selectableItemBackground">

            <RelativeLayout
                android:id="@+id/classText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/blue_round_background">

                <com.idreameducation.ipreppal.util.TextViewHeadingFont
                    android:id="@+id/classTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Class 10"
                    android:textAllCaps="false"
                    android:textSize="12dp"
                    android:textColor="#0077FF" />

                <ImageView
                    android:id="@+id/classDownArrow"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="5dp"
                    android:layout_centerVertical="true"
                    android:visibility="gone"
                    android:layout_toRightOf="@+id/classTextView"
                    app:srcCompat="@mipmap/down_arrow" />

            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/languageLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@+id/classLayout"
            android:background="?selectableItemBackground">

            <RelativeLayout
                android:id="@+id/languageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/blue_round_background">

                <ImageView
                    android:id="@+id/langIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_centerVertical="true"
                    android:visibility="visible"
                    app:srcCompat="@mipmap/lang" />

                <com.idreameducation.ipreppal.util.TextViewHeadingFont
                    android:id="@+id/languageTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@+id/langIcon"
                    android:layout_marginLeft="5dp"
                    android:text="EN"
                    android:textAllCaps="false"
                    android:textSize="12dp"
                    android:textColor="#0077FF" />

                <ImageView
                    android:id="@+id/languageDownArrow"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="5dp"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@+id/languageTextView"
                    app:srcCompat="@mipmap/down_arrow" />

            </RelativeLayout>

        </RelativeLayout>

        <ImageView
            android:id="@+id/searchImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginVertical="10dp"
            android:layout_above="@+id/line_home"
            android:layout_alignParentTop="true"
            android:layout_marginRight="10dp"
            android:visibility="gone"
            android:layout_toStartOf="@+id/textViewDummyText"
            android:src="@drawable/ic_search_black"
            />

        <com.idreameducation.ipreppal.util.TextViewWithRegularFont
            android:id="@+id/textViewDummyText"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_toLeftOf="@+id/reletive_"
            android:layout_toRightOf="@+id/imageViewBack"
            android:gravity="center"
            android:text=""
            android:textAllCaps="false"
            android:textAppearance="?android:textAppearanceLarge"
            android:textColor="@android:color/black"
            android:textStyle="normal" />

        <RelativeLayout
            android:id="@+id/reletive_"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:gravity="end|center">

            <ImageView
                android:id="@+id/imageViewLangaugeSwitch"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="?selectableItemBackground"
                android:padding="10dp"
                android:visibility="gone"
                app:srcCompat="@mipmap/search_iprep" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lotie_player"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:visibility="visible"
                android:layout_marginRight="10dp"
                app:lottie_loop="true" />

            <ImageView
                android:id="@+id/imageViewMessage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:background="?selectableItemBackground"
                android:padding="10dp"
                android:scaleType="fitXY"
                android:tag="no_notification"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_bell" />

        </RelativeLayout>

        <FrameLayout
            android:id="@+id/topTransparentBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:layout_above="@+id/container"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/downArrowImg"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="35dp"
                    android:layout_marginLeft="100dp"
                    app:srcCompat="@mipmap/down_arrow_icon" />

                <com.idreameducation.ipreppal.util.TextViewHeadingFont
                    android:id="@+id/selectSubjectText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@+id/downArrowImg"
                    android:text="सीखने के लिए एक विषय का चयन करें"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

            </RelativeLayout>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:id="@+id/line_home"
            android:elevation=".5dp"
            android:visibility="gone"
            android:layout_below="@+id/imageViewDrawer"
            android:background="#DEDEDE" />

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottomNavigationViewLayout"
            android:layout_below="@+id/line_home"/>

        <View
            android:id="@+id/line_home2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@+id/bottomNavigationViewLayout"
            android:background="#DEDEDE" />

        <FrameLayout
            android:id="@+id/bottomNavigationViewLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="5dp"
            android:visibility="visible"
            android:layout_alignParentBottom="true" >

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNavigationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:backgroundTint="@color/white"
                app:itemIconTint="@null"
                app:itemTextColor="@drawable/bottom_navigation_colors"
                app:menu="@menu/pal_bottom_menu" />

        </FrameLayout>

        <Button
            android:id="@+id/buttonBimonthly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:text="Bi monthly test"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonreports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Reports"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonAssignedContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_toRightOf="@+id/buttonreports"
            android:text="Assigned Content"
            android:textAllCaps="false"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/bottomTransparentBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/topTransparentBg"
            android:background="#CC000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fullScreenTransparentBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/introlayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:background="@color/offwhite"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginHorizontal="100dp"
            android:orientation="vertical"
            android:background="@drawable/item_background_white">

            <FrameLayout
                android:layout_weight="1"
                android:id="@+id/videocontainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginHorizontal="60dp"
                android:layout_marginVertical="20dp"
                android:background="@color/black"
                android:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17dp"
                android:gravity="center"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="10dp"
                android:textColor="@color/blue"
                android:text="Welcome to iPrep PAL"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:gravity="center"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="10dp"
                android:textColor="#666666"
                android:layout_marginBottom="20dp"
                android:text="Learn how to use iPrep PAL. Play the video to start. "/>



        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/floating_draw_contact_us"
        android:layout_marginBottom="60dp"
        android:layout_width="wrap_content"
        android:layout_height="100dp">

    </include>

    <include layout="@layout/onboading_layout"/>

    <include layout="@layout/navigationdrawer_new"></include>

    <include layout="@layout/notification_drawer_layout"></include>

    <LinearLayout
        android:id="@+id/expireLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/white_solid_shadow_less_redius"
        android:padding="10dp"
        android:visibility="gone"
        tools:ignore="MissingDefaultResource">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <ImageView
                android:id="@+id/imageViewClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginRight="20dp"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_cross_btn"/>

            <LinearLayout
                android:id="@+id/linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imageViewClose"
                android:orientation="vertical">


                <ImageView
                    android:id="@+id/imageliscence"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="25dp"
                    android:src="@drawable/daysexpired"
                    android:visibility="visible" />

                <com.idreameducation.ipreppal.util.TextViewBodyFont
                    android:id="@+id/expiretext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imageViewClose"
                    android:layout_marginHorizontal="40dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"

                    android:textColor="@android:color/black"
                    android:textSize="17sp" />

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/enterpath"
                    android:layout_gravity="center_horizontal"
                    android:hint="Please, enter the path here"
                    android:padding="15dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="15dp"
                    android:visibility="gone"
                    android:background="@drawable/gray_iprep"
                    android:textColor="#212121"
                    android:text=""><requestFocus></requestFocus>
                </EditText>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"

                    android:padding="10dp">

                    <com.idreameducation.ipreppal.util.TextViewHeadingFont
                        android:id="@+id/textViewclose"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_below="@+id/text"
                        android:minWidth="150dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/blue_iprep_button"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Close"
                        android:textAppearance="?android:textAppearanceMedium"
                        android:textColor="@android:color/white"
                        tools:ignore="NotSibling" />

                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>

