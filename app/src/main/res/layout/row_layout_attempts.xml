<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    tools:ignore="MissingDefaultResource">


    <View
        android:id="@+id/divider3"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginLeft="25dp"
        android:background="#C9C9C9" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/divider3"
        android:orientation="horizontal">


        <com.idreameducation.ipreppal.util.TextViewWithRegularFont
            android:id="@+id/textViewAttempt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/divider3"
            android:background="@drawable/gray_iprep"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#9E9E9E"
            android:text="05 oct 2021"
            android:textSize="10dp" />

        <View
            android:id="@+id/divider4"
            android:layout_width="25dp"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:background="#C9C9C9" />

        <com.idreameducation.ipreppal.util.TextViewWithRegularFont
            android:id="@+id/textViewAttemptCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toEndOf="@id/divider4"
            android:gravity="center|left"
            android:layout_gravity="center"
            android:textColor="#666666"
            android:text="0:06 Sec"
            android:textSize="10dp" />

    </LinearLayout>
</RelativeLayout>