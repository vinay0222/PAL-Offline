<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">


    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="350dp"
        android:layout_margin="10dp"
        android:paddingHorizontal="10dp"
        android:background="@drawable/white_solid_shadow_less_redius"
        android:elevation="3dp"
        android:orientation="vertical">

        <com.idreameducation.ipreppal.util.TextViewWithRegularFont
            android:id="@+id/joinBatchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textAppearance="?android:textAppearanceMedium"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:text="Join Batch" />

        <com.idreameducation.ipreppal.util.TextViewHeadingFont
            android:id="@+id/joinBatchDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textAppearance="?android:textAppearanceLarge"
            android:text="Enter Invitation code" />


        <EditText
            android:layout_gravity="center"
            android:hint="- - - -"
            android:textColorHint="@android:color/black"
            android:gravity="center"
            android:id="@+id/codeEditText"
            android:background="@drawable/rounded_ed"
            android:layout_marginTop="50dp"
            android:maxLength="4"
            android:inputType="textCapCharacters"
            android:layout_width="match_parent"
            android:layout_height="60dp" />


        <com.idreameducation.ipreppal.util.TextViewWithRegularFont
            android:layout_width="match_parent"
            android:text="Join Batch"
            android:foreground="?selectableItemBackground"
            android:id="@+id/textViewJoinBatch"
            android:layout_marginTop="30dp"
            android:layout_marginHorizontal="30dp"
            android:gravity="center"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="@android:color/white"
            android:background="@drawable/blue_iprep_button"
            android:layout_height="60dp" />

    </LinearLayout>
</RelativeLayout>