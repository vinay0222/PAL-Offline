<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:paddingTop="20dp"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageViewBack"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="5dp"
        android:background="?selectableItemBackground"
        android:padding="5dp"
        app:srcCompat="@drawable/ic_back_round" />

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_toRightOf="@+id/imageViewBack"
        android:gravity="center_vertical"
        android:text="Contact Us"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="10dp"
        android:textAllCaps="false"
        android:fontFamily="@font/inter_regular"
        android:textColor="@android:color/black" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/textViewTitle"
        android:background="@color/grey" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <ImageView
            android:layout_weight="1.3"
            android:id="@+id/imageViewBell"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="50dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/contactus_image">

        </ImageView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imageViewBell"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="16dp"
                android:gravity="center"
                android:layout_marginHorizontal="20dp"
                android:minHeight="50dp"
                android:text="Please get in touch and we will be happy to help you."
                android:textColor="#666666"/>

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewMessge1"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/textViewDetails"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="If you"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@color/black"
                android:visibility="gone" />

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewMessge2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/textViewMessge1"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="If you have an"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black"
                android:visibility="gone" />

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewMessge3"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/textViewMessge2"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="If you"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black"
                android:visibility="gone" />

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewMessge3"
                android:layout_marginTop="30dp"
                android:gravity="center|left"
                android:padding="15dp"
                android:text="For any more information regarding the app and if you need any assistance in using it better, pls connect with us over e-mail or whats app here: "
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/black"
                android:visibility="gone" />

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/callTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/EmailTextView"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="60dp"
                android:background="#49CBC7"
                android:drawableLeft="@android:drawable/ic_menu_call"
                android:drawablePadding="-30dp"
                android:elevation="1dp"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:minHeight="55dp"
                android:paddingLeft="20dp"
                android:text=""
                android:textAllCaps="true"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/call1LinearLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginHorizontal="60dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/rounded_edittext">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/call_icon_contact_us"/>

                <TextView
                    android:id="@+id/call1TextView"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Call US"
                    android:visibility="gone"
                    android:gravity="center|left"
                    android:textSize="14dp"
                    android:textColor="@color/textcolour"
                    android:layout_marginHorizontal="20dp"/>

                <TextView
                    android:layout_weight="1"
                    android:id="@+id/contactNumberText2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="18008899710"
                    android:gravity="center|right"
                    android:textSize="14dp"
                    android:textColor="@color/textcolour"
                    android:layout_marginHorizontal="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/WhatsappTLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginHorizontal="60dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rounded_edittext_watsapp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/whatsapp_icon_contact_us"/>

                <TextView
                    android:id="@+id/WhatsappTextView"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Call US"
                    android:gravity="center|left"
                    android:textSize="14dp"
                    android:visibility="gone"
                    android:textColor="@color/textcolour"
                    android:layout_marginHorizontal="20dp"/>

                <TextView
                    android:layout_weight="1"
                    android:id="@+id/contactNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="+91 7678289650"
                    android:gravity="center|right"
                    android:textSize="14dp"
                    android:textColor="@color/textcolour"
                    android:layout_marginHorizontal="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/EmailLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginHorizontal="60dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/rounded_edittext_email">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/email_icon_contact_us"/>

                <TextView
                    android:id="@+id/EmailTextView"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Call US"
                    android:gravity="center|left"
                    android:textSize="14dp"
                    android:visibility="gone"
                    android:textColor="@color/textcolour"/>

                <TextView
                    android:layout_weight="1"
                    android:id="@+id/mailid_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="+91 7678289650"
                    android:gravity="center|right"
                    android:textSize="12dp"
                    android:textColor="@color/textcolour"
                    android:layout_marginHorizontal="10dp"/>

            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewMessge3"
                android:layout_marginTop="10dp"
                android:layout_marginRight="60dp"
                android:background="@drawable/rounded_edittext"
                android:drawableLeft="@mipmap/call_icon_contact_us"
                android:drawablePadding="15dp"
                android:elevation="1dp"
                android:foreground="?selectableItemBackground"
                android:gravity="center|left"
                android:minHeight="50dp"
                android:paddingLeft="20dp"
                android:textSize="10dp"
                android:text=""
                android:textColor="@android:color/black"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/call1TextView"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="60dp"
                android:background="@drawable/rounded_edittext_watsapp"
                android:drawableLeft="@mipmap/whatsapp_icon_contact_us"
                android:drawablePadding="15dp"
                android:elevation="1dp"
                android:foreground="?selectableItemBackground"
                android:gravity="center|left"
                android:minHeight="50dp"
                android:paddingLeft="20dp"
                android:textSize="10dp"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/WhatsappTextView"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="60dp"
                android:background="@drawable/rounded_edittext_email"
                android:drawableLeft="@mipmap/email_icon_contact_us"
                android:drawablePadding="15dp"
                android:elevation="1dp"
                android:foreground="?selectableItemBackground"
                android:gravity="center|left"
                android:minHeight="50dp"
                android:paddingLeft="20dp"
                android:textSize="10dp"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>


    <include layout="@layout/floating_draw_contact_us"></include>

    <LinearLayout
        android:id="@+id/connection_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:visibility="visible" />

        <TextView
            android:id="@+id/slow_internet_Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/progressBar"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="Slow Internet Connection"
            android:textColor="@color/black"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageViewCrossVideo2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_below="@id/slow_internet_Text"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:padding="10dp"
            android:scaleType="fitXY"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

    </LinearLayout>

</RelativeLayout>