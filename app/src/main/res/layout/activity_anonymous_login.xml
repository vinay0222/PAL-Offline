<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center|bottom"
    android:id="@+id/root_view"
    android:background="#ffffff"
    android:orientation="vertical"
    android:paddingLeft="15dp"
    android:paddingRight="15dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:isScrollContainer="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonSignInStudent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:padding="120dp"
                android:src="@drawable/ic_logo_pal" />

            <TextView
                android:id="@+id/textViewtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textSize="14dp"
                android:text="Enter Details"
                android:fontFamily="@font/inter_medium"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/textViewtitleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewtitle"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="25dp"
                android:gravity="center|left"
                android:text="Your Name"
                android:textSize="14dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="#9E9E9E" />

            <AutoCompleteTextView
                android:id="@+id/nameStudent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@+id/textViewtitleName"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/gray_iprep"
                android:cursorVisible="true"
                android:inputType="text"
                android:digits="0123456789qwertzuiopasdfghjklyxcvbnm ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                android:hint="Enter your name"
                android:imeOptions="actionNext"
                android:maxLength="30"
                android:fontFamily="@font/inter_medium"
                android:nextFocusDown="@id/textViewtitlePassword"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColorHint="#9E9E9E"
                android:textSize="16dp"
                android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined" />

            <TextView
                android:id="@+id/textViewtitlePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nameStudent"
                android:layout_centerHorizontal="true"
                android:gravity="center|left"
                android:text="Password"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="#666666"
                android:textSize="16sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/passwordStudent"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@+id/textViewtitlePassword"
                android:layout_centerHorizontal="true"
                android:background="@drawable/gray_iprep"
                android:cursorVisible="false"
                android:hint="Password is same as your name"
                android:imeOptions="actionDone"
                android:nextFocusUp="@id/nameStudent"
                android:nextFocusDown="@id/rollnoStudent"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rollmobilelayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nameStudent"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="left"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/textViewtitleRollNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/passwordStudent"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="5dp"
                        android:gravity="center|left"
                        android:text="Roll Number"
                        android:textSize="14dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#9E9E9E"
                        android:visibility="visible" />


                    <EditText
                        android:id="@+id/rollnoStudent"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_below="@+id/textViewtitleRollNo"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/gray_iprep"
                        android:cursorVisible="true"
                        android:hint="Enter your Roll Number"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="10"
                        android:nextFocusUp="@id/passwordStudent"
                        android:nextFocusDown="@id/buttonSignInStudent"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:textColorHint="#9E9E9E"
                        android:textSize="16dp"
                        android:fontFamily="@font/inter_medium"
                        android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
                        android:visibility="visible" />

                </LinearLayout>

                <View
                    android:layout_width="26dp"
                    android:layout_height="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewtitlemobileNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/passwordStudent"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="5dp"
                        android:gravity="center|left"
                        android:text="Mobile number"
                        android:textSize="14dp"
                        android:textColor="#9E9E9E"
                        android:fontFamily="@font/inter_medium"
                        android:visibility="visible" />

                    <EditText
                        android:id="@+id/mobilenoStudent"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_below="@+id/textViewtitleRollNo"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/gray_iprep"
                        android:cursorVisible="true"
                        android:hint="Enter your Number"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="10"
                        android:nextFocusUp="@id/passwordStudent"
                        android:nextFocusDown="@id/buttonSignInStudent"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:singleLine="true"
                        android:textColorHint="#9E9E9E"
                        android:textSize="16dp"
                        android:fontFamily="@font/inter_medium"
                        android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
                        android:visibility="visible" />

                </LinearLayout>

            </LinearLayout>



            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewParterCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/buttonSignip"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:padding="5dp"
                android:text="Do you have partner code?"
                android:textAppearance="?android:textAppearanceLarge"
                android:textColor="#F7F9FA"
                android:visibility="gone" />


        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/buttonSignInStudent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/blue_iprep_button"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:text="Sign up"
        android:textColor="@android:color/white"
        android:textSize="16dp"
        app:layout_constraintBottom_toTopOf="@+id/selectProfileText"
        tools:layout_editor_absoluteX="15dp" />

    <com.idreameducation.ipreppal.util.TextViewHeadingFont
        android:id="@+id/selectProfileText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:layout_below="@+id/tabIDEditText"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="20dp"
        android:gravity="center"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="Select your profile"
        android:textSize="15dp"
        android:textColor="@color/blue" />


    <TextView
        android:id="@+id/loginwithAPPID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="20dp"
        android:gravity="center"
        android:text="Login with SRN"
        android:textColor="@color/blue"
        android:textSize="15dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="15dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENGLISH"
            android:textSize="12dp"
            android:fontFamily="@font/inter_medium"/>

        <Switch
            android:id="@+id/languageSwitch"
            android:layout_width="wrap_content"
            android:layout_height="5dp"
            android:layout_marginHorizontal="10dp"
            android:textOff="ENG"
            android:textOn="HI"
            android:track="@drawable/switch_track"
            android:thumb="@drawable/switch_thumb" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="हिंदी"
            android:textSize="12dp"
            android:fontFamily="@font/inter_medium"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
