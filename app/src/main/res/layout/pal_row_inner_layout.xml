<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginLeft="10dp"
    android:id="@+id/RelativeClickListener"
    android:layout_marginRight="10dp"
    android:layout_marginBottom="5dp"
    android:gravity="top">

    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewDate"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:visibility="gone"
        android:gravity="center"
        android:text=""
        android:textSize="14dp"/>


    <ImageView
        android:id="@+id/image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/test_icon"/>


    <com.idreameducation.ipreppal.util.TextViewHeadingFont
        android:id="@+id/textViewTopicName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toLeftOf="@+id/textViewAttempts"
        android:layout_toRightOf="@+id/image"
        android:text=""
        android:textSize="14dp"
        android:textColor="@android:color/black" />

    <com.idreameducation.ipreppal.util.TextViewHeadingFont
        android:id="@+id/textViewDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewTopicName"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_toLeftOf="@+id/textViewAttempts"
        android:layout_toRightOf="@+id/image"
        android:text=""
        android:textSize="12dp"
        android:textColor="@android:color/darker_gray" />


    <LinearLayout
        android:id="@+id/linearAttempts1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewDetail"
        android:layout_toLeftOf="@+id/textViewAttempts"
        android:layout_toRightOf="@+id/image"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_below="@+id/textViewDetail"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:layout_toRightOf="@+id/image"
            android:background="@color/gray_oast" />

        <LinearLayout
            android:id="@+id/linearAttempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/image"
            android:orientation="vertical">


        </LinearLayout>

    </LinearLayout>


    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewAttempts"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_alignParentRight="true"
        android:drawableRight="@mipmap/down_pal"
        android:gravity="center"
        android:text=""
        android:textAppearance="?android:textAppearanceSmall" />


</RelativeLayout>