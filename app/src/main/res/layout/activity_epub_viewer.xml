<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--        <androidx.appcompat.widget.Toolbar-->

        <!--            android:id="@+id/toolbar"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="60dp"-->
        <!--            android:background="@color/blue"-->
        <!--            android:elevation="4dp"-->
        <!--            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"-->
        <!--            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />-->

        <LinearLayout
            android:id="@+id/title_toolbar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#F4F4F5"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageViewBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="4dp"
                android:padding="3dp"
                android:layout_gravity="center_vertical"
                android:src="@mipmap/back_iprep" />

            <TextView
                android:id="@+id/titleBooks"
                android:layout_width="390dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_toRightOf="@+id/imageViewBack"
                android:gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:padding="2dp"
                android:text="Books"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />


        </LinearLayout>




        <com.idreameducation.ipreppal.CustomWebView
            android:id="@+id/custom_WebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/seekLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#F4F4F5">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="390dp"
                android:layout_height="55dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/seek_bar_ruler"
                android:thumb="@drawable/seek_bar_slider" />

            <!--            <TextView-->
            <!--                android:id="@+id/textViewPercent"-->
            <!--                android:layout_width="wrap_content"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_alignEnd="@+id/seekBar"-->
            <!--                android:layout_alignBottom="@+id/seekBar"-->
            <!--                android:layout_toRightOf="@+id/seekBar"-->
            <!--                android:layout_marginEnd="2dp"-->
            <!--                android:layout_marginBottom="2dp"-->
            <!--                android:text="0%"-->
            <!--                android:padding="10dp"-->
            <!--                android:visibility="gone"-->
            <!--                android:textSize="15sp" />-->

            <TextView
                android:id="@+id/textViewPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="350dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="2dp"
                android:padding="5dp"
                android:text="Page: "
                android:textSize="16sp"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/chapterlist"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="3dp"
                android:layout_toRightOf="@+id/textViewPage"
                android:src="@mipmap/chapter_list_new"/>


            <ImageView
                android:id="@+id/settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="3dp"
                android:layout_marginRight="10dp"
                android:padding="3dp"
                android:src="@mipmap/settingsnew"/>


        </RelativeLayout>

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/epub_nav_content_header"
        app:menu="@menu/epub_nav_content_menu"
        android:visibility="gone"
        tools:ignore="MissingClass" />

    <include layout="@layout/epub_nav_settings"></include>


</androidx.drawerlayout.widget.DrawerLayout>
