<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:gravity="center|left"
    android:orientation="vertical"
    android:background="@drawable/white_solid_shadow_less_redius"
    android:paddingLeft="40dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/close_version_ly_btn"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_gravity="right"
        android:src="@drawable/ic_cross_btn"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:textColor="@color/layout_title"
            android:fontFamily="@font/inter_medium"
            android:text="Details"/>

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/layout_title"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/inter_regular"
            android:text="App Version"/>

        <TextView
            android:id="@+id/app_version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:text="1.02"/>


        <TextView
            android:id="@+id/updateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/layout_title"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_regular"
            android:text="App Updated on"/>

        <TextView
            android:id="@+id/updated_date_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12-06-2022"
            android:fontFamily="@font/inter_regular"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/open_launcher_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Launcher"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/inter_medium"
            android:layout_gravity="start"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/blue_iprep_button"/>

    </LinearLayout>


</LinearLayout>