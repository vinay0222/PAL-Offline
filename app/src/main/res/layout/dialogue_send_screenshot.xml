<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true"
    android:layout_marginBottom="20dp"
    android:layout_marginHorizontal="10dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:elevation="3dp">

            <TextView
                android:id="@+id/heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D9EAFF"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:paddingTop="22dp"
                android:paddingBottom="12dp"
                android:text="Report Your Error"
                android:textColor="#0064C8" />

            <ImageView
                android:id="@+id/close_pop"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignTop="@+id/heading"
                android:layout_alignBottom="@+id/heading"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="21dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="0dp"
                android:src="@drawable/ic_close_blue" />


        </RelativeLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:gravity="center|bottom">

                <ImageView
                    android:id="@+id/imageViewScreenshot"
                    android:layout_width="100dp"
                    android:layout_height="180dp"
                    android:padding="2dp"
                    android:scaleType="fitXY"
                    android:background="@drawable/ic_back_screenshot"/>

                <TextView
                    android:id="@+id/send_feed_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send Feeedback"
                    android:textColor="#1F2937"
                    android:textSize="14dp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginTop="10dp"/>

                <EditText
                    android:layout_weight="1"
                    android:id="@+id/textSendWithImage_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FAFAFA"
                    android:minHeight="200dp"
                    android:textSize="13dp"
                    android:gravity="top|left"
                    android:padding="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Found an issue? or do you have any feedback for us? We apologize for any inconvenience, and we'd love to hear from you. It would be nice if you could share the details here, but please do not share sensitive information."
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/inc_screentext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#9CA3AF"
                    android:textSize="12dp"
                    android:layout_marginTop="25dp"
                    android:drawableLeft="@drawable/ic_blue_info"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="We have included a screenshot of this page" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DEDEDE"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:gravity="center|left"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginRight="5dp"
                        android:layout_gravity="center|left">

                        <TextView
                            android:id="@+id/contect_us_text"
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Contact us"
                            android:textSize="16dp"
                            android:layout_gravity="center"
                            android:textColor="#1F2937"
                            android:fontFamily="@font/inter_medium"/>

                        <TextView
                            android:weightSum="1"
                            android:id="@+id/contect_us_text2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="You can also contact our support team for assistance:"
                            android:textColor="#6B7280"
                            android:layout_gravity="center"
                            android:textSize="12dp"
                            android:fontFamily="@font/inter_regular"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:gravity="left|center"
                        android:layout_gravity="center|left">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|left"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:background="#FAFAFA"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginLeft="10dp"
                                android:src="@drawable/ic_call"/>

                            <TextView
                                android:id="@+id/number_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18008899710"
                                android:textSize="12dp"
                                android:layout_marginLeft="10dp"
                                android:gravity="left"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|left"
                            android:layout_marginTop="5dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:paddingRight="5dp"
                            android:background="#FAFAFA"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginLeft="10dp"
                                android:src="@drawable/ic_email"/>

                            <TextView
                                android:id="@+id/email_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="share@idreameducation.org"
                                android:textSize="12dp"
                                android:layout_marginLeft="10dp"
                                android:gravity="left"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DEDEDE"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginTop="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|bottom"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:layout_weight="1"
                        android:id="@+id/textViewCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        style="?android:attr/borderlessButtonStyle"
                        android:background="@drawable/blue_iprep_trans"
                        android:textColor="#3B82F6"
                        android:elevation="0dp"
                        android:capitalize="none"
                        android:textAllCaps="false"
                        android:text="cancel"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginRight="10dp"/>

                    <Button
                        android:layout_weight="1"
                        android:id="@+id/textViewSend"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        style="?android:attr/borderlessButtonStyle"
                        android:background="@drawable/blue_iprep_nontrans"
                        android:text="send"
                        android:textColor="#FFFFFF"
                        android:elevation="0dp"
                        android:capitalize="none"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_regular"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.cardview.widget.CardView>