<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/onboading_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:background="#ADAFAFAF"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="100dp"
        app:cardElevation="15dp"
        app:cardCornerRadius="20dp"
        android:layout_gravity="center">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:orientation="vertical">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_weight="1"
                android:id="@+id/animationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:src="@drawable/iprep_logo"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:scaleType="centerInside"/>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/onboading_heading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to iPrep PAL"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/onboading_body_text"
                    android:layout_weight="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="iPrep offers a comprehensive coverage of subjects with personalised adaptive learning which means that iPrep will guide you at every step."
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/black"
                    android:textSize="14dp"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="bottom">

                <Button
                    android:id="@+id/onboarding_previousBtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:background="@drawable/blue_iprep_button"
                    android:fontFamily="@font/open_sans_bold"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="Previous"
                    android:textSize="10dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_weight="1"
                    android:visibility="visible"
                    android:id="@+id/onboading_skip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14dp"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginRight="20dp"
                    android:textColor="@color/blue"/>

                <Button
                    android:id="@+id/onboading_nextbtn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:text="Next"
                    android:elevation="-10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:textSize="10dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textColor="@color/white"
                    android:background="@drawable/blue_iprep_button"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="bottom">

                <TextView
                    android:id="@+id/onboading_point1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="."
                    android:textSize="35dp"
                    android:textColor="@color/selected_pointer"
                    android:layout_marginTop="-20dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/onboading_point2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="."
                    android:textSize="35dp"
                    android:textColor="@color/unselected_pointer"
                    android:layout_marginTop="-20dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/onboading_point3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="."
                    android:textSize="35dp"
                    android:textColor="@color/unselected_pointer"
                    android:layout_marginTop="-20dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/onboading_point4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="."
                    android:textSize="35dp"
                    android:textColor="@color/unselected_pointer"
                    android:layout_marginTop="-20dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/onboading_point5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="."
                    android:textSize="35dp"
                    android:textColor="@color/unselected_pointer"
                    android:layout_marginTop="-20dp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/onboading_point6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="."
                    android:textSize="35dp"
                    android:textColor="@color/unselected_pointer"
                    android:layout_marginTop="-20dp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
