<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root_view"
    android:background="@color/white">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/imageViewBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackground"
        android:layout_margin="15dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_back_round"/>

    <TextView
        android:id="@+id/textViewdTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imageViewBack"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="10dp"
        android:gravity="center"
        android:fontFamily="@font/inter_medium"
        android:text=""
        android:textColor="@color/black"
        android:textSize="18dp" />

    <ImageView
        android:id="@+id/imageViewDImage"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewdTest"
        android:layout_marginTop="20dp"
        android:src="@mipmap/d_test_image"/>

    <RelativeLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:layout_below="@+id/imageViewDImage"
        android:layout_centerInParent="true"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginBottom="10dp"
            android:drawableLeft="@drawable/ic_dot_light_blue"
            android:drawablePadding="10dp"
            android:text=""
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/black"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/step2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/step1"
            android:layout_gravity="left"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:drawableLeft="@drawable/ic_dot_light_blue"
            android:drawablePadding="10dp"
            android:text=""
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/black"
            android:textSize="14dp" />




        <TextView
            android:id="@+id/step3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/step2"
            android:layout_gravity="left"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_dot_light_blue"
            android:drawablePadding="10dp"
            android:text=""
            android:textColor="@color/black"
            android:fontFamily="@font/inter_medium"
            android:textSize="14dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/step4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/step3"
            android:layout_gravity="left"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_dot_light_blue"
            android:drawablePadding="10dp"
            android:text=""
            android:textColor="@color/black"
            android:fontFamily="@font/inter_medium"
            android:textSize="14dp"
            android:visibility="visible" />


    </RelativeLayout>

    <TextView
        android:id="@+id/buttonPreceed"
        android:layout_width="280dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/blue_iprep_button"
        android:gravity="center"
        android:text=""
        android:visibility="visible"
        android:textColor="@color/white"
        android:textSize="16sp" />



</RelativeLayout>