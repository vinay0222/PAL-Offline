<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_background_white"
    android:clickable="true"
    android:layout_marginVertical="10dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:minHeight="80dp"
    android:layout_marginHorizontal="10dp"
    android:paddingBottom="@dimen/row_padding_vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/row_padding_vertical">

    <TextView
        android:id="@+id/textViewTestName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:textSize="15dp"
        android:gravity="center|left"
        android:paddingHorizontal="10dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/textcolour" />


    <com.idreameducation.ipreppal.util.TextViewBodyFont
        android:id="@+id/textViewTestScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewTestName"
        android:layout_gravity="center"
        android:layout_marginRight="10dp"
        android:background="@drawable/skip_button_color"
        android:backgroundTint="#F8FAFC"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="10dp"
        android:text="स्कोर: "
        android:textAllCaps="false"
        android:textColor="#707070"
        android:textSize="17sp"
        android:visibility="visible" />

</RelativeLayout>