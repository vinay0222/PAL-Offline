<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/questionLayout">

        <RelativeLayout
            android:id="@+id/languageLayout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:visibility="gone">

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"

            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/languageLayout"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentBottom="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:background="@drawable/question_back_card"
                android:elevation="3dp"
                android:layout_margin="10dp"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/textViewSubmit"
                    android:orientation="vertical"


                    android:weightSum="5">

                    <RelativeLayout
                        android:id="@+id/linearLayout2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/blue_solid_shadow"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">


                        <com.idreameducation.ipreppal.util.TextViewBodyFont
                            android:id="@+id/textViewQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text=""
                            android:maxLines="3"
                            android:layout_above="@+id/textViewReadMoreQuestion"
                            android:layout_margin="2dp"
                            android:textAppearance="?android:textAppearanceMedium"
                            android:textColor="@android:color/white" />

                        <com.idreameducation.ipreppal.util.TextViewBodyFont
                            android:id="@+id/textViewReadMoreQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="0dp"
                            android:layout_marginRight="5dp"
                            android:gravity="right"
                            android:text="ReadMore"
                            android:visibility="visible"
                            android:textAppearance="?android:textAppearanceSmall"
                            android:textColor="@android:color/white" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp">


                        <ImageView
                            android:id="@+id/questionImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingTop="2dp" />


                    </LinearLayout>

                    <com.idreameducation.ipreppal.util.TextViewHeadingFont
                        android:id="@+id/textViewQuestionNotAttempted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=""
                        android:textAppearance="?android:textAppearanceMedium"
                        android:textColor="@android:color/holo_red_dark"
                        android:visibility="gone" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1.5"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="10dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:id="@+id/linearYourAnswer"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:layout_weight="1"

                            android:background="@drawable/white_solid_shadow_black_border"

                            android:orientation="vertical">

                            <com.idreameducation.ipreppal.util.TextViewBodyFont
                                android:id="@+id/textViewyouranswerText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="10dp"
                                android:layout_marginTop="10dp"
                                android:gravity="center|top"
                                android:text=""
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@android:color/black" />

                            <com.idreameducation.ipreppal.util.TextViewBodyFont
                                android:id="@+id/incorrectOption"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="3"
                                android:padding="5dp"
                                android:singleLine="false"
                                android:text=""
                                android:textAppearance="?android:textAppearanceMediumInverse"
                                android:textColor="@android:color/black" />


                            <ImageView
                                android:padding="10dp"

                                android:visibility="gone"
                                android:id="@+id/imageViewOption1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                               />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearCorrectAnswer"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/white_solid_shadow_black_border"

                            android:orientation="vertical">

                            <com.idreameducation.ipreppal.util.TextViewBodyFont
                                android:id="@+id/textViewCorrectAnswerText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="10dp"
                                android:layout_marginTop="10dp"
                                android:gravity="center|top"
                                android:text=""
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@android:color/black" />

                            <com.idreameducation.ipreppal.util.TextViewBodyFont
                                android:id="@+id/correctOption"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="3"
                                android:padding="5dp"
                                android:singleLine="false"
                                android:text=""
                                android:textAppearance="?android:textAppearanceMediumInverse"
                                android:textColor="@android:color/black" />

                            <ImageView
                                android:id="@+id/imageViewOption2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="10dp"
                                android:visibility="gone" />

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="3dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginTop="3dp"
                        android:layout_weight="1.3"
                        android:background="@drawable/white_solid_shadow_black_border"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp"

                        android:weightSum="2">
                        <com.idreameducation.ipreppal.util.TextViewBodyFont
                            android:id="@+id/textViewF"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text=""
                            android:textAppearance="?android:textAppearanceMedium"
                            android:textColor="@android:color/black" />
                        <ImageView
                            android:id="@+id/imageViewFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:layout_weight="1.6"
                             />

                        <com.idreameducation.ipreppal.util.TextViewBodyFont
                            android:id="@+id/textViewFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1.5"
                            android:gravity="center"
                            android:maxLines="4"
                            android:text=""
                            android:textAppearance="?android:textAppearanceSmall"
                            android:textColor="@android:color/black"
                            android:visibility="visible" />

                        <com.idreameducation.ipreppal.util.TextViewBodyFont
                            android:id="@+id/textViewReadMore"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight=".4"
                            android:gravity="right"

                            android:text=""
                            android:textAppearance="?android:textAppearanceSmall"
                            android:textColor="@color/colorPrimaryDark" />
                    </LinearLayout>


                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>