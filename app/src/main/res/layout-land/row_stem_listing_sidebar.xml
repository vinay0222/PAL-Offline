<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reletiveParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="5dp"
    android:gravity="center|left"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:gravity="center|left"
            android:orientation="horizontal">


            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewSno"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1."
                android:layout_gravity="center"
                android:textAllCaps="false"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@color/colorAccent" />


            <com.idreameducation.ipreppal.util.TextViewHeadingFont
                android:id="@+id/textViewTopicName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/textViewSno"
                android:gravity="center|left"
                android:paddingRight="5dp"
                android:text="vbvjhgbvhjg"
                android:textAllCaps="false"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@color/black" />


        </LinearLayout>


    </RelativeLayout>
</LinearLayout>