<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linear"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="60dp">

        <com.idreameducation.ipreppal.util.TextViewHeadingFont
            android:id="@+id/textViewUserName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center|left"
            android:text=""
            android:textAllCaps="false"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="@android:color/black" />
    </LinearLayout>


    <TextView
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_height="1dp"
        android:layout_below="@+id/linear"
        android:background="@color/gray_toast" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/linearBottom"
        android:layout_below="@+id/line"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="5dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <TextView
        android:id="@+id/noChatText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:visibility="gone"
        android:text="No Chat found"
        android:textColor="#212121" />
    <LinearLayout
        android:id="@+id/linearBottom"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#F8F8F8"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"

            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="?selectableItemBackground"
            android:padding="10dp"
            android:src="@mipmap/plus_icon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:padding="2dp"
            android:weightSum="2">

            <ImageView
                android:id="@+id/attachmentBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="?selectableItemBackground"
                android:padding="10dp"
                android:src="@mipmap/plus_icon"
                android:visibility="gone"/>

            <com.idreameducation.ipreppal.util.EditTextWithFont
                android:id="@+id/messageEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@null"
                android:backgroundTint="@null"
                android:gravity="center|left"
                android:hint="Type a Message"
                android:imeOptions="actionDone"
                android:paddingLeft="10dp"
                android:textColor="@android:color/black"
                android:textColorHint="#DEDEDE" />

            <ImageView
                android:id="@+id/sendButton"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?selectableItemBackground"
                android:padding="6dp"
                android:src="@drawable/share" />
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>