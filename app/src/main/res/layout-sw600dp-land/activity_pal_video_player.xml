<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reletive"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="horizontal"
    tools:ignore="MissingDefaultResource">

    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
        android:id="@+id/youtube_player_view"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="match_parent" />

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:layout_gravity="center" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" />

    <ImageView
        android:id="@+id/imageViewCross"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_above="@+id/videoView"
        android:layout_alignParentRight="true"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:visibility="gone"
        android:layout_marginBottom="-50dp"
        app:srcCompat="@mipmap/cross" />

    <ImageView
        android:id="@+id/imageViewFullScreen"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_above="@+id/videoView"
        android:layout_alignParentRight="true"
        android:visibility="gone"
        android:layout_marginTop="0dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="-40dp"
        android:background="?selectableItemBackground"
        app:srcCompat="@mipmap/full_screen" />

    <RelativeLayout
        android:id="@+id/linearLayoutBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/video_background"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageViewBackButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentLeft="true"
            android:layout_margin="10dp"
            android:background="@color/trans"
            android:padding="10dp"
            android:scaleType="fitXY"
            app:srcCompat="@mipmap/cross" />

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/videoNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_toRightOf="@+id/imageViewBackButton"
            android:text=""
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_above="@+id/videoViewWrapper"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/textViewNextVideo"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/transparent_button"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="Next Video"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/white" />

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/textViewPractice"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:visibility="gone"
                android:layout_marginLeft="10dp"
                android:background="@drawable/transparent_button"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="Practice"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/videoViewWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>


</RelativeLayout>