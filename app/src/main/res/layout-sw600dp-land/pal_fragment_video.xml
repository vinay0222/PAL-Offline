<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoLayout"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/messageLayout1"
            android:layout_width="450dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="8dp"
            android:elevation="0dp"
            app:cardElevation="0dp"
            android:background="@drawable/blue_iprep"
            android:gravity="center"
            android:visibility="visible"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/messageLayout"
                android:layout_centerHorizontal="true"
                android:background="@color/white"
                android:gravity="center"
                android:layout_margin="1dp"
                app:cardCornerRadius="7dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/messageLayout11"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/messageLayout"
                    android:layout_centerHorizontal="true"
                    android:background="@color/green"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageViewStar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:src="@mipmap/green_star_icon" />

                    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                        android:id="@+id/textViewText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/imageViewStar"
                        android:layout_weight="1"
                        android:text="Practice"
                        android:textColor="#6A6A6A"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/textViewContinue"
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:background="@mipmap/right_arrow_blue"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/messageLayout2"
            android:layout_width="450dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="8dp"
            android:elevation="0dp"
            app:cardElevation="0dp"
            android:background="@drawable/blue_iprep"
            android:gravity="center"
            android:visibility="visible"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/messageLayout"
                android:layout_centerHorizontal="true"
                android:background="@color/white"
                android:gravity="center"
                android:layout_margin="1dp"
                app:cardCornerRadius="7dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/messageLayout22"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/messageLayout"
                    android:layout_centerHorizontal="true"
                    android:background="@color/green"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="20dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:src="@mipmap/green_star_icon" />

                    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                        android:id="@+id/textViewText2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/imageViewStar"
                        android:layout_weight="1"
                        android:text="Select Topic and Start learning"
                        android:textColor="#6A6A6A"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:background="@mipmap/right_arrow_blue"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </androidx.cardview.widget.CardView>

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/currentTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Topic Name"
            android:visibility="gone"
            android:textSize="18dp"
            android:layout_margin="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarSize="10dp"
            android:background="@color/white"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </LinearLayout>

    <com.idreameducation.ipreppal.util.TextViewHeadingFont
        android:id="@+id/textViewTopicName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"
        android:visibility="gone"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="10dp"
        android:textAppearance="?android:textAppearanceLarge" />


</RelativeLayout>
