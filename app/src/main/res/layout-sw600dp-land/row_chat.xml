<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center|left"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/date_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:visibility="invisible"
            android:background="#9E9E9E"/>

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/textViewDate"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="30 Nov 2022"
            android:layout_marginHorizontal="10dp"
            android:textAllCaps="false"
            android:textAppearance="?android:textAppearanceSmall"
            android:textColor="#9E9E9E" />

        <View
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:visibility="invisible"
            android:background="#9E9E9E"/>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/reletiveReciever"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/chat_gray"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/recieverImageview"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:visibility="visible"
            android:layout_marginTop="10dp"
            android:scaleType="centerInside"/>

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/textViewMessageReciver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:maxWidth="250dip"
            android:text=""
            android:paddingBottom="5dp"
            android:paddingTop="5dp"
            android:textColor="#212121"
            android:textSize="16sp" />

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/timeReciever"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/textViewMessageReciver"
            android:gravity="left|center"
            android:text=""
            android:layout_marginBottom="5dp"
            android:textColor="#212121"
            android:textSize="10sp" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/reletiveSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginBottom="7dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/chat"
        android:elevation="0dp"
        android:gravity="right"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/senderImageview"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:visibility="visible"
            android:layout_marginTop="10dp"
            android:scaleType="centerInside"/>

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/textViewMessageSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dip"
            android:text=""
            android:paddingBottom="5dp"
            android:paddingTop="5dp"
            android:textColor="#212121"
            android:textSize="16sp" />

        <com.idreameducation.ipreppal.util.TextViewBodyFont
            android:id="@+id/timeSender"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textViewMessageSender"
            android:gravity="right|center"
            android:layout_marginBottom="5dp"
            android:text=""
            android:textColor="#212121"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>