<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:shimmer="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reletiveTop"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_gravity="center"
    android:layout_margin="5dp"
    app:ignore="NamespaceTypo">

    <FrameLayout
        android:id="@+id/videoThumnailLayout"
        android:layout_width="wrap_content"
        android:layout_centerVertical="true"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageViewThumnail"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_marginLeft="3dp"
            android:layout_gravity="center"
            android:scaleType="fitXY" />

        <View
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginLeft="3dp"
            android:background="@drawable/video_background_layout" />

        <ImageView
            android:id="@+id/playButtonThumnail"
            android:layout_width="20dp"
            android:layout_gravity="center"
            android:layout_height="20dp"
            android:src="@mipmap/play_icon"/>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar5"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <com.idreameducation.ipreppal.util.TextViewBodyFont
        android:id="@+id/textViewVideoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="5dp"
        android:layout_toRightOf="@+id/videoThumnailLayout"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingLeft="5dp"
        android:text=""
        android:textColor="#212121"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.idreameducation.ipreppal.util.RoundedHorizontalProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="100dp"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:layout_marginHorizontal="10dp"
        android:layout_below="@+id/textViewVideoName"
        android:layout_toRightOf="@+id/videoThumnailLayout"
        android:indeterminate="false"
        android:progress="0"
        app:backgroundColor="#F4C999"
        app:progressColor="#FB9E36" />

    <TextView
        android:id="@+id/textViewSelected"
        android:layout_width="3dp"
        android:visibility="gone"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:background="#FB9E36" />
</RelativeLayout>