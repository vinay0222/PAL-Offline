<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"

    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="10dp"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/imageViewselection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="5dp"
        android:gravity="center"
        android:src="@mipmap/right" />

    <ImageView
        android:id="@+id/textViewClassID"
        android:layout_width="50dp"
        android:layout_height="50dp"

android:layout_toRightOf="@+id/imageViewselection"
        android:layout_margin="5dp"
        android:gravity="center"
        android:src="@mipmap/group" />


    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewUserName"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="5dp"
        android:gravity="center"
        android:layout_toRightOf="@+id/textViewClassID"
        android:text=""
        android:textAppearance="?android:textAppearanceMedium"
        android:textColor="#212121" />


</RelativeLayout>