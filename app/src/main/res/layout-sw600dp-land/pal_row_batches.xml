<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/classLayout"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="10dp"
    android:orientation="vertical">


    <com.idreameducation.ipreppal.util.TextViewHeadingFont
        android:id="@+id/textViewClassID"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="5dp"
        android:background="@drawable/class_text_back"
        android:gravity="center"
        android:text=""
        android:textAppearance="?android:textAppearanceMedium"
        android:textColor="@color/blue" />


    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewClassName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/textViewClassID"
        android:text=""
        android:textAppearance="?android:textAppearanceMedium"
        android:textColor="#212121" />


    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewSubjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewClassName"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@+id/textViewStudentCount"
        android:layout_toRightOf="@+id/textViewClassID"
        android:text=""
        android:visibility="gone"
        android:textAppearance="?android:textAppearanceSmall"
        android:textColor="@color/gray" />

    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewStudentCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="10dp"
        android:text=""
        android:textAppearance="?android:textAppearanceSmall"
        android:textColor="@color/gray"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/mainRelative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/white_solid_new_half_redius"
        android:elevation="2dp"
        android:minHeight="100dp"
        android:orientation="vertical"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="0dp"
            android:paddingRight="0dp">


            <ImageView
                android:id="@+id/imageViewDelete"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="10dp"
                android:padding="0dp"
                android:src="@mipmap/not_selected" />

            <RelativeLayout
                android:id="@+id/reletiveTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_toRightOf="@+id/imageViewDelete"
                android:background="#FFF"
                android:paddingLeft="10dp"
                android:paddingBottom="4dp">


                <com.idreameducation.ipreppal.util.TextViewBodyFont
                    android:id="@+id/textStudentCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:text=""
                    android:textAllCaps="true"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textStudentCount"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentLeft="true"
                    android:text=""
                    android:textAllCaps="true"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:visibility="gone" />


                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_below="@+id/textStudentCount"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="15dp"
                    android:orientation="vertical"
                    android:weightSum="1">

                    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                        android:id="@+id/textViewStudents"
                        android:layout_width="120dp"
                        android:layout_height="30dp"
                        android:background="@drawable/lightbrown"
                        android:gravity="center"
                        android:text="Students"
                        android:textAppearance="?android:textAppearanceSmall"
                        android:textColor="@android:color/black" />
                </LinearLayout>
            </RelativeLayout>


        </RelativeLayout>
    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="40dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:elevation="0dp"
            android:paddingLeft="0dp"
            android:weightSum="3">

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/textViewAssignContent"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_margin="2dp"
                android:layout_toRightOf="@+id/textViewAssignContent"
                android:layout_weight="1.3"
                android:background="@drawable/floating_light_blue"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="Assign Content"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/black" />


            <View
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:background="@android:color/white">

            </View>

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/textViewReport"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/floating_light_blue"
                android:gravity="center"
                android:text="Reports"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:background="@android:color/white"></View>

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/textViewChat"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_margin="2dp"
                android:layout_toRightOf="@+id/textViewAssignContent"
                android:layout_weight="0.7"
                android:background="@drawable/floating_light_blue"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="Chat"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:background="@android:color/white"></View>


            <com.idreameducation.ipreppal.util.TextViewHeadingFont
                android:id="@+id/textViewClassBorad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:text="hvfhvfjvbfjv"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:visibility="gone" />


        </LinearLayout>


    </RelativeLayout>

    <TextView
        android:id="@+id/line"
        style="?android:attr/listSeparatorTextViewStyle"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_margin="15dp"
        android:background="#bdbdbd"
        android:visibility="gone" />

</RelativeLayout>