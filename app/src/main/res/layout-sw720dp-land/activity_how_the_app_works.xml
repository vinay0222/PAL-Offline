            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewLifeSkillsDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:paddingLeft="55dp"
                android:visibility="gone"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />





            <LinearLayout
                android:id="@+id/booksLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"

                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:padding="8dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/light_yellow_back"
                    android:src="@mipmap/app_works_books" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewBooks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:paddingLeft="5dp"
                    android:layout_marginLeft="20dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />


            </LinearLayout>

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewBooksDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:paddingLeft="55dp"
                android:visibility="gone"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />










            <LinearLayout
                android:id="@+id/practiceLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"

                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:src="@mipmap/practice" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewPractice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:paddingLeft="5dp"
                    android:layout_marginLeft="20dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
