<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageViewBack"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:background="?selectableItemBackground"
        android:padding="15dp"
        app:srcCompat="@mipmap/back_black" />

    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewDummyText"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginRight="50dp"
        android:layout_toRightOf="@+id/imageViewBack"
        android:gravity="center"
        android:layout_marginLeft="10dp"
        android:text=""
        android:textAllCaps="false"
        android:textAppearance="?android:textAppearanceMedium"
        android:textColor="@android:color/black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewDummyText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="0dp">


            <LinearLayout
                android:id="@+id/videoLessonsLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"

                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/light_yellow_back"
                    android:src="@mipmap/app_works_video" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewVideoLessons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:paddingLeft="5dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />


            </LinearLayout>

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewVideoLessonsDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:paddingLeft="55dp"
                android:visibility="gone"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />




            <LinearLayout
                android:id="@+id/toysLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"

                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:layout_marginRight="10dp"
                    android:visibility="gone"
                    android:background="@drawable/light_yellow_back"
                    android:src="@mipmap/app_works_video" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewToys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:paddingLeft="5dp"
                    android:layout_marginLeft="20dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />


            </LinearLayout>

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewToysDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:paddingLeft="55dp"
                android:visibility="gone"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />








            <LinearLayout
                android:id="@+id/lifeSkillsLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"

                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:layout_marginRight="10dp"
                    android:visibility="gone"
                    android:background="@drawable/light_yellow_back"
                    android:src="@mipmap/app_works_video" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewLifeSkills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:paddingLeft="5dp"
                    android:layout_marginLeft="20dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />


