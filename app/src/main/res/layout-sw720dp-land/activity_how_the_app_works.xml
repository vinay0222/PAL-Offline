                android:textColor="@android:color/black" />


            <LinearLayout
                android:id="@+id/TestPaperLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"

                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:src="@mipmap/paper" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewPaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:paddingLeft="5dp"
                    android:layout_marginLeft="20dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />


            </LinearLayout>

            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewPaperDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:visibility="gone"
                android:paddingLeft="55dp"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />

            <LinearLayout
                android:id="@+id/offlineUsageLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:visibility="gone"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:elevation="4dp"
                    android:padding="5dp"
                    android:src="@mipmap/offline_usage" />

                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewofflineUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/black_down"
                    android:paddingLeft="5dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />


            </LinearLayout>


            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewofflineUsageDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:paddingLeft="55dp"
                android:visibility="gone"
                android:text=""
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />

            <LinearLayout
                android:id="@+id/AnalyticsLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:visibility="gone"
