            </LinearLayout>


            <com.idreameducation.ipreppal.util.TextViewBodyFont
                android:id="@+id/textViewAnalyticsDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:paddingLeft="55dp"
                android:text=""
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black" />









            <LinearLayout
                android:id="@+id/profileLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:visibility="gone"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/light_yellow_back"
                    android:src="@mipmap/user" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/plus_icon"
                    android:layout_marginLeft="20dp"
                    android:paddingLeft="5dp"
                    android:text=""
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />

