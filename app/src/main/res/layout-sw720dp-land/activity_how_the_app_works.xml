                android:textColor="@android:color/black" />

            <LinearLayout
                android:id="@+id/iPrepWorkLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="?selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:elevation="4dp"
                    android:padding="5dp"
                    android:src="@mipmap/foundational_topic" />


                <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                    android:id="@+id/textViewiPrepWork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:drawableRight="@mipmap/black_forward"
                    android:paddingLeft="5dp"
                    android:text="Foundational topic"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@android:color/black" />

            </LinearLayout>

            <com.idreameducation.ipreppal.util.TextViewWithRegularFont
                android:id="@+id/TextViewVideo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp"
