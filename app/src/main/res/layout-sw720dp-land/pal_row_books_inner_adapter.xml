<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:shimmer="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="5dp"
    android:background="?selectableItemBackground"
    android:layout_margin="5dp"
    android:layout_gravity="center">

    <ImageView
        android:id="@+id/imageViewThumnail"
        android:layout_width="70dp"
        android:layout_height="100dp"
        android:src="@mipmap/books_stories_1"
        android:scaleType="fitCenter"
        android:layout_margin="5dp" />

    <com.idreameducation.ipreppal.util.TextViewWithRegularFont
        android:id="@+id/textViewBooksName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/imageViewThumnail"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:maxLines="4"
        android:text="hhwfhsdfvhdf"
        android:textColor="@color/black"
        android:textSize="14dp" />

</RelativeLayout>